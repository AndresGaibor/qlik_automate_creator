# =============================================================================
# QLIK AUTOMATE CREATOR — CONFIGURACIÓN
# =============================================================================
# Copia este archivo a .env y ajusta los valores.
# Con los valores por defecto, la aplicación funciona sin cambios.
#
# PUERTO WEB (frontend Nginx)
PORT_WEB=8080

# PUERTO API (backend Bun)
PORT_API=3000

# IP del host para bind (127.0.0.1 = solo local, 0.0.0.0 = todas las interfaces)
HOST_IP=127.0.0.1

# DOMINIO (para CORS y URLs — se puede cambiar después desde la UI)
# Ejemplos:
#   localhost          — desarrollo local
#   api.midominio.com — producción con dominio propio
SERVER_NAME=localhost

# =============================================================================
# BASE DE DATOS
# =============================================================================
# El default funciona con Docker Compose (servicio "postgres" interno).
# Cambia este valor solo si usas una base de datos externa o en la nube.
DATABASE_URL=postgres://qlik_app:cambiar_en_produccion@postgres:5432/qlik_automatizaciones

# =============================================================================
# POSTGRES (Docker Compose)
# =============================================================================
# Solo necesarios si quieres credenciales personalizadas para PostgreSQL.
# POSTGRES_USER=qlik_app
# POSTGRES_PASSWORD=cambiar_en_produccion
