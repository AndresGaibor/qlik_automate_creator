NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://qlik_app:desarrollo@localhost:5432/qlik_automatizaciones

# Fallback OAuth heredado. Es opcional cuando cada tenant se configura desde la app.
QLIK_CLIENT_ID=
QLIK_CLIENT_SECRET=
QLIK_REDIRECT_URI=http://localhost:3000/api/auth/qlik/callback
QLIK_OAUTH_SCOPES="user_default offline_access identity.name:read identity.email:read identity.subject:read identity.picture:read automations automations.private automations.shared spaces:read apps:read data-integration"

CIFRADO_CLAVE_PRINCIPAL=32_bytes_base64_encoded_key_aqui

REMOTE_API_URL=https://apiqd.andresgaibor.com
REMOTE_API_KEY=clave-super-segura123

# Bootstrap inicial idempotente
BOOTSTRAP_ORGANIZACION_NOMBRE=Empresa Demo
BOOTSTRAP_TENANT_NOMBRE=Tenant Qlik principal
BOOTSTRAP_TENANT_HOST=empresa.eu.qlikcloud.com
BOOTSTRAP_TENANT_ID_QLIK=tenant-qlik-001
# Solo para crear/migrar el primer superadmin; admite varios correos separados por coma.
SUPERADMINMAIL=admin@empresa.com
BOOTSTRAP_SUPERADMIN_NOMBRE=Superadministrador
